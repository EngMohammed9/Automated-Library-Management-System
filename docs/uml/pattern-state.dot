digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65", fontname="DejaVu Sans"]; node [shape=box, style="rounded,filled", fillcolor="#edf7f8", color="#09636f", fontcolor="#173a42", fontname="DejaVu Sans", fontsize=13, margin="0.14,0.10"]; edge [color="#09636f", fontname="DejaVu Sans", fontsize=10, fontcolor="#173a42"];

node [shape=record, style=filled];
Copy [label="{BookCopy|state: CopyState\l}"];
State [label="{CopyState (interface)|borrow(copy, memberId)\lcheckIn(copy)\lhold(copy, memberId)\l}"];
Available [label="{AvailableState}"]; CheckedOut [label="{CheckedOutState}"]; Reserved [label="{ReservedState}"];
Copy -> State [label="current state: 1", dir=both, arrowtail=diamond, arrowhead=none];
Available -> State [arrowhead=empty, style=dashed];
CheckedOut -> State [arrowhead=empty, style=dashed];
Reserved -> State [arrowhead=empty, style=dashed];

}